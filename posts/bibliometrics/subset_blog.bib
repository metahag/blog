@article{mazzotti_effects_2010,
	title = {Effects of {Computer}-{Assisted} {Instruction} on {Students}' {Knowledge} of {Postschool} {Options}},
	volume = {33},
	url = {http://proxy.lnu.se/login?url=https://www.proquest.com/docview/742867270?accountid=14827&bdid=20891&_bd=6gVG7DMiwvLP9n58otgYoys%2B1LE%3D},
	doi = {10.1177/0885728809338714},
	abstract = {Enhancing students' ability to make informed choices is an important precursor to successful choice-making, decision-making, and goal-setting. This study used a multiple-baseline design across behaviors replicated across participants to examine the effects of computer-assisted instruction on acquisition of students' knowledge of postschool options (i.e., employment, education, independent living). Results demonstrated a functional relationship between baseline and intervention for all four students. Implications for practice and future research are discussed. (Contains 4 tables and 4 figures.)},
	number = {1},
	journal = {Career Development for Exceptional Individuals},
	publisher = {SAGE Publications and Hammill Institute on Disabilities},
	author = {Mazzotti, Valerie L. and Test, David W. and Wood, Charles L. and Richter, Sharon},
	year = {2010},
	pages = {25--40},
}

@article{sigafoos_evidence-based_2008,
	title = {Evidence-{Based} {Practice} in the {Classroom}: {Evaluating} a {Procedure} for {Reducing} {Perseverative} {Requesting} in an {Adolescent} with {Autism} and {Severe} {Intellectual} {Disability}},
	volume = {32},
	url = {http://proxy.lnu.se/login?url=https://www.proquest.com/docview/61948194?accountid=14827&bdid=20891&_bd=YfzHGEnjCN9wf%2FF49bLt7pg4AbE%3D},
	doi = {10.1080/10300110701839931},
	abstract = {Management of inappropriate behaviour is a major priority in special education. Evidence-based practice dictates that interventions to reduce inappropriate behaviour should be evaluated at the individual level to demonstrate their efficacy in the classroom. This study illustrates the evaluation of an evidence-based procedure (response interruption) for reducing perseverative requesting in an adolescent boy with autism and severe intellectual disability. The boy used a speech-generating device to request snacks during baseline and response interruption conditions. During both conditions, the boy had to wait 30 seconds while the snack was being prepared. Requests that occurred during this wait interval were defined as perseverative. Intervention involved blocking perseverative requests and prompting the child to wait. An ABAB design was used to evaluate the effects of the response interruption procedure. The results demonstrated that response interruption effectively reduced perseverative requesting, while maintaining appropriate requesting at other times. The study illustrates how special educators might evaluate evidence-based practice in the classroom. (Contains 1 figure.)},
	number = {1},
	journal = {Australasian Journal of Special Education},
	publisher = {Routledge},
	author = {Sigafoos, Jeff and Ganz, Jennifer and O'Reilly, Mark and Lancioni, Giulio},
	year = {2008},
	pages = {55--65},
}

@article{nuari_learning_2019,
	title = {Learning of {Division} {Operation} for {Mental} {Retardations}' {Student} through {Math} {GASING}},
	volume = {10},
